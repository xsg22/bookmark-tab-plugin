{
  "manifest_version": 3,
  "name": "SearchDeck - New Tab Search Hub",
  "version": "1.0",
  "description": "Turn Chrome's new tab into a keyboard-friendly global search workspace for bookmarks, history, and web results.",
  "permissions": [
    "bookmarks",
    "storage",
    "favicon",
    "history",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "打开 SearchDeck 命令面板"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "SearchDeck - New Tab Search Hub"
  }
}
