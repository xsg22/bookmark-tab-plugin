{
  "manifest_version": 3,
  "name": "TabShelf - New Tab Bookmark Manager",
  "version": "1.0",
  "description": "Turn Chrome's new tab into a keyboard-friendly bookmark and recent-history workspace for quick access.",
  "permissions": [
    "bookmarks",
    "storage",
    "favicon",
    "history",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "打开 TabShelf 命令面板"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "TabShelf - New Tab Bookmark Manager"
  }
}
